{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "custom.jsonata",
    "custom.regex",
    "github-actions",
    "npm",
    "pip_requirements",
    "terraform"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    "security/provider/**",
    "build-support/tls-armv7/**"
  ],
  "packageRules": [],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.(txt|pip)$/"
    ]
  }
}
